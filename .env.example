# ---- Server ----
NODE_ENV=development
PORT=8000
# Docker Compose overrides this with mongodb://mongo:27017/... ; for Atlas use your mongodb+srv:// string.
# Use "memory" for a throw-away in-memory database (npm run dev:local).
MONGODB_URI=mongodb://127.0.0.1:27017/projectforge?directConnection=true
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- AI (optional; without a key the app uses clearly-labelled built-in templates) ----
AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible API) | none
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=

# ---- Embeddings / vector search ----
EMBEDDING_BACKEND=hashing      # hashing | transformers (npm i @xenova/transformers in backend)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
VECTOR_SEARCH=auto             # auto | on | off  ($vectorSearch needs Atlas or mongodb-atlas-local)
VECTOR_INDEX_NAME=embedding_index

# ---- GitHub intelligence (all optional; the app works with GITHUB_TOKEN empty) ----
# Token is used only by the backend and raises the GitHub search limit (unauthenticated: ~10 searches/minute).
GITHUB_TOKEN=
GITHUB_CACHE_TTL_HOURS=12          # cached GitHub search results (MongoDB TTL)
RESEARCH_CACHE_TTL_HOURS=24        # cached research-paper searches
GITHUB_RATE_LIMIT_PER_MINUTE=10    # per user
RESEARCH_RATE_LIMIT_PER_MINUTE=15  # per user
AI_RATE_LIMIT_PER_MINUTE=20        # per user, for analysis/AI endpoints
SEARCH_TIMEOUT_SECONDS=20          # per external request (raise on slow networks)
SEARCH_RETRY_DELAY_MS=700          # one automatic retry for transient failures
INR_PER_USD=85                     # used to convert an INR budget to USD for scoring

# ---- External search (all optional; keys only raise rate limits) ----
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Putting your email in the two MAILTO values moves you to the providers' faster "polite" pools (strongly recommended).
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# ---- Demo data ----
AUTO_SEED=true
SEED_ADMIN_EMAIL=admin@projectforge.ai
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_EMAIL=demo@projectforge.ai
SEED_DEMO_PASSWORD=Demo@12345
